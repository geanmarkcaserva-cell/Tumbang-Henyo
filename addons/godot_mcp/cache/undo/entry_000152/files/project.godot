; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tumbang Henyo"
run/main_scene="res://scenes/game/game.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

MCPRuntime="*uid://t5glcrwvkt67"
QuizDatabase="*res://autoload/quiz_database.gd"
GameManager="*res://autoload/game_manager.gd"

[display]

window/size/viewport_width=1920.0
window/size/viewport_height=1080.0
window/size/window_width_override=1280.0
window/size/window_height_override=720.0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0.0

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

